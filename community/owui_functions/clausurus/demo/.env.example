# Copy to .env (gitignored) and fill in. Never commit a filled-in .env.

# Session secret for Open WebUI, e.g. the output of: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Apertus, used by Clausurus only to detect personal data (never to answer).
APERTUS_API_BASE=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
APERTUS_API_KEY=
APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B
APERTUS_LOCATION=🇨🇭 Zürich, Switzerland · Swisscom

# Shown to users in the "where your data goes" view.
SERVER_LOCATION=💻 Your computer (local demo)

# At least one provider key. For the demo these become admin fallback keys, so every
# demo user spends them; in production leave them empty and let users bring their own.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4.1-mini
