# Copy this file to .env (which is gitignored) and fill in real values.
# NEVER commit a filled-in .env. NEVER put real keys in any tracked file.

# Open WebUI needs a secret key for sessions/tokens. Generate one, e.g.:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=

# --- Apertus (used internally by Clausurus for entity/PII detection only) ---
# Point this at any OpenAI-compatible Apertus deployment, e.g. Public AI's own,
# or the Swiss AI Weeks hackathon endpoint for demo purposes.
APERTUS_API_BASE=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
APERTUS_API_KEY=
APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B

# --- External providers Clausurus can route BYOK requests to ---
# Fill in at most one for the demo (the demo only needs one working target).
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
